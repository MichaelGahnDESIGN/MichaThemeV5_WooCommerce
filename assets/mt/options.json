                "system": "Wie das Gerät",
                "light": "Hell",
                "dark": "Dunkel"
            },
            "attr": "data-theme"
        },
        {
            "id": "accent",
            "group": "colors",
            "type": "select",
            "mode": "simple",
            "label": "Akzentfarbe",
            "default": "indigo",
